    "\n",
    "def uitweiking(m, veerconstante):\n",
    "    u = ((m) * g)/(-veerconstante)\n",
    "    return u\n",
    "\n",
    "def cap_met_twee(u):\n",
    "    Cplaat = epsilon_0 * epsilon_plaat * (breedte_plaat * -(u))/d\n",
    "    Clucht = epsilon_0 * epsilon_lucht * (breedte_plaat * -(0.1+u))\n",
