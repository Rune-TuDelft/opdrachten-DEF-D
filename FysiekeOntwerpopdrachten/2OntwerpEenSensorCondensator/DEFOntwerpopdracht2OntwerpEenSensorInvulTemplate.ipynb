    "\n",
    "\n",
    "#-----ONTWERP----------------\n",
    "def ontwerp(m, veerconstante):\n",
    "    u = ((m) * g)/(veerconstante)\n",
    "\n",
    "    for i in range(len(u)):\n",
    "        if u[i] > 0.1:\n",
